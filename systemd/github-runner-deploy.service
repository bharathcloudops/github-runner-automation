#==============================================================================
# DEPLOY RUNNER SYSTEMD SERVICE
#==============================================================================

#==============================================================================
# UNIT DEPENDENCIES
#==============================================================================

[Unit]
Description=GitHub Actions deploy runner (platform,deploy)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

#==============================================================================
# SERVICE LIFECYCLE
#==============================================================================

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/github-runner/current
ExecStart=/usr/bin/docker compose up --detach --build runner-deploy runner-deploy-02
ExecReload=/usr/bin/docker compose up --detach --build runner-deploy runner-deploy-02
ExecStop=/usr/bin/docker compose stop runner-deploy runner-deploy-02
TimeoutStartSec=600
TimeoutStopSec=120

#==============================================================================
# SERVICE INSTALLATION
#==============================================================================

[Install]
WantedBy=multi-user.target
